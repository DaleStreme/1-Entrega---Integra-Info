<%- include('../partials/header') %>
<%- include('../partials/menu') %>

<main class="container py-4">
    <div class="card shadow-lg">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-tags"></i> Categorias
            </h4>
            <a href="/admin/categorias/form-cadastrar" class="btn btn-light btn-sm">
                <i class="bi bi-plus-circle"></i> Nova Categoria
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <td>ID</td>
                            <td>Nome</td>
                            <td>Descrição</td>
                            <td style="width: 180px;">Ações</td>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (let i = 0; i < categorias.length; i++) { %>
                            <tr>
                                <td><%= categorias[i].id %></td>
                                <td><%= categorias[i].nome %></td>        
                                <td><%= categorias[i].descricao %></td>
                                <td>
                                    <a href="#" class="btn btn-secondary btn-sm">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    
                                    <a href="/admin/categorias/excluir/<%= categorias[i].id %>" 
                                       class="btn btn-dark btn-sm">
                                        <i class="bi bi-trash"></i> Excluir
                                    </a>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>